<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>GerenciamentoMecanica.Auth.Contracts</PackageId>
    <Version>1.0.0</Version>
    <Authors>pknfelps</Authors>
    <Description>Regras compartilhadas de documentos CPF/CNPJ e emissão JWT do sistema de mecânica.</Description>
    <RepositoryUrl>https://github.com/pknfelps/GerenciamentoMecanicaSistema</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
