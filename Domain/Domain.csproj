<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.26.0.140279">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain.Interface\Domain.Interface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Share document validation with AuthFunction without including the JWT issuer in the API. -->
    <Compile Include="../GerenciamentoMecanica.Auth.Contracts/CpfRules.cs" Link="Customer/Shared/CpfRules.cs" />
    <Compile Include="../GerenciamentoMecanica.Auth.Contracts/CnpjRules.cs" Link="Customer/Shared/CnpjRules.cs" />
    <Compile Include="../GerenciamentoMecanica.Auth.Contracts/DocumentRules.cs" Link="Customer/Shared/DocumentRules.cs" />
    <Compile Include="../GerenciamentoMecanica.Auth.Contracts/DocumentValidation.cs" Link="Customer/Shared/DocumentValidation.cs" />
  </ItemGroup>

</Project>
